# Copy to .env and adjust as needed. All backend settings are prefixed
# SENTINELIQ_ and map onto backend/app/core/config.py::Settings.
#
# Every *_BACKEND / *_PROVIDER value below is actually read by the corresponding
# factory function, so switching an adapter is a config change. Selecting an
# unimplemented target fails loudly at startup or first use rather than silently
# falling back.

# --- Metadata DB (Postgres in docker-compose; SQLite default for bare local dev) ---
SENTINELIQ_DATABASE_URL=postgresql+psycopg2://sentineliq:sentineliq@localhost:5432/sentineliq
# SENTINELIQ_DATABASE_URL=sqlite:///./sentineliq.db

# Bootstrap tables with create_all() on startup. Fine for SQLite dev/test; set
# false anywhere that outlives a process and let `alembic upgrade head` own the
# schema (which is what backend/docker-entrypoint.sh does).
SENTINELIQ_AUTO_CREATE_SCHEMA=true

# --- Auth ---
SENTINELIQ_JWT_SECRET=change-me-in-production-this-is-a-dev-only-secret
SENTINELIQ_JWT_ALGORITHM=HS256
SENTINELIQ_ACCESS_TOKEN_EXPIRE_MINUTES=720
SENTINELIQ_REFRESH_TOKEN_EXPIRE_DAYS=30
# Failed logins per (email, IP) before a 429, and the window they count in.
SENTINELIQ_LOGIN_RATE_LIMIT_ATTEMPTS=10
SENTINELIQ_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
SENTINELIQ_AUTH_PROVIDER=local

# --- Telemetry store adapter (documented target: ClickHouse/OpenSearch) ---
# postgres | clickhouse (unimplemented) | opensearch (unimplemented)
SENTINELIQ_TELEMETRY_STORE_BACKEND=postgres

# --- Queue adapter (documented target: Kafka/Redpanda) ---
# in_process: synchronous, no worker needed (and none runs).
# redis:      real producer/consumer split -- REQUIRES app/worker.py to be running,
#             or ingested events are accepted and never stored.
# kafka:      documented target, unimplemented.
SENTINELIQ_QUEUE_BACKEND=in_process
SENTINELIQ_REDIS_URL=redis://localhost:6379/0
SENTINELIQ_QUEUE_DLQ_SUFFIX=.dlq

# --- Detection (FM4) ---
SENTINELIQ_DETECTION_ON_INGEST=true
# Bounds an on-demand rule run so it cannot degrade into a full table scan.
SENTINELIQ_DETECTION_DEFAULT_WINDOW_MINUTES=10080
SENTINELIQ_DETECTION_MAX_SCAN_EVENTS=50000

# --- Threat intelligence (FM5) ---
SENTINELIQ_THREAT_INTEL_PROVIDER=local
SENTINELIQ_THREAT_INTEL_ENRICH_ON_INGEST=true
SENTINELIQ_THREAT_INTEL_DEFAULT_TTL_HOURS=168
# SENTINELIQ_THREAT_INTEL_FEED_URL=https://example.invalid/indicators.json
# Prefer naming an env var per feed (ThreatFeed.api_key_env_var) over this global.
# SENTINELIQ_THREAT_INTEL_FEED_API_KEY=

# --- ML detection (C8) ---
# Off by default: an unsupervised model with no analyst feedback loop will
# produce false positives, so enabling it is a deliberate choice per deployment.
SENTINELIQ_ML_DETECTION_ENABLED=false
SENTINELIQ_ML_MODEL_DIR=./var/models
SENTINELIQ_ML_SCORE_ALERT_THRESHOLD=0.85
SENTINELIQ_ML_TRAINING_MIN_EVENTS=200

# --- SOAR (FM7) ---
SENTINELIQ_SOAR_ENABLED=true
# Leave true. False removes the human-in-the-loop gate on destructive actions,
# which this platform's authorized-defensive-tooling scope relies on.
SENTINELIQ_SOAR_REQUIRE_APPROVAL_FOR_HIGH_RISK=true
SENTINELIQ_SOAR_WEBHOOK_TIMEOUT_SECONDS=5.0
SENTINELIQ_SOAR_MAX_ACTIONS_PER_RUN=25

# --- Notifications (FM6 alerting) ---
# log | webhook | email (any combination)
SENTINELIQ_NOTIFICATION_CHANNELS=["log"]
# Minimum severity that pages anyone. Lowering this to "informational" is the
# fastest way to get your alert channel muted by its users.
SENTINELIQ_NOTIFICATION_MIN_SEVERITY=high
# SENTINELIQ_NOTIFICATION_WEBHOOK_URL=https://hooks.slack.com/services/...
SENTINELIQ_NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=5.0
# SENTINELIQ_SMTP_HOST=smtp.example.test
SENTINELIQ_SMTP_PORT=587
SENTINELIQ_SMTP_USE_TLS=true
SENTINELIQ_SMTP_FROM_ADDRESS=alerts@sentineliq.local
# SENTINELIQ_SMTP_USERNAME=
# SENTINELIQ_SMTP_PASSWORD=

# --- Compliance reporting (FM9) ---
SENTINELIQ_REPORT_DIR=./var/reports
SENTINELIQ_REPORT_URL_TTL_SECONDS=3600
# Defaults to JWT_SECRET when unset, so there is no silently-unsigned mode.
# SENTINELIQ_REPORT_SIGNING_SECRET=

# --- Billing (documented target: real Stripe) ---
SENTINELIQ_BILLING_PROVIDER=mock_stripe
SENTINELIQ_STRIPE_API_KEY=sk_test_placeholder
# Required before POST /v1/billing/webhook/stripe will accept anything.
# SENTINELIQ_STRIPE_WEBHOOK_SECRET=whsec_...
SENTINELIQ_DEFAULT_PLAN_SLUG=free

# --- Observability ---
SENTINELIQ_LOG_LEVEL=INFO
# text for humans, json for log aggregation.
SENTINELIQ_LOG_FORMAT=text
SENTINELIQ_METRICS_ENABLED=true

# --- CORS ---
SENTINELIQ_CORS_ORIGINS=["http://localhost:5173"]

# --- Frontend ---
# BUILD-TIME only: Vite inlines VITE_* vars into the bundle, so this must be a
# build arg for the container image (see frontend/Dockerfile). Passing it as a
# runtime container env has no effect. "/v1" is the same-origin path nginx
# proxies to the backend.
VITE_API_BASE_URL=/v1
