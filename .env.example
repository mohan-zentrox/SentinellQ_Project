# Copy to .env and adjust as needed. All backend settings are prefixed
# SENTINELIQ_ and map onto backend/app/core/config.py::Settings.

# --- Metadata DB (Postgres in docker-compose; SQLite default for bare local dev) ---
SENTINELIQ_DATABASE_URL=postgresql+psycopg2://sentineliq:sentineliq@localhost:5432/sentineliq
# SENTINELIQ_DATABASE_URL=sqlite:///./sentineliq.db

# --- Auth ---
SENTINELIQ_JWT_SECRET=change-me-in-production-this-is-a-dev-only-secret
SENTINELIQ_JWT_ALGORITHM=HS256
SENTINELIQ_ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Telemetry store adapter (documented target: ClickHouse/OpenSearch) ---
SENTINELIQ_TELEMETRY_STORE_BACKEND=postgres

# --- Queue adapter (documented target: Kafka/Redpanda) ---
SENTINELIQ_QUEUE_BACKEND=in_process
SENTINELIQ_REDIS_URL=redis://localhost:6379/0

# --- Billing (documented target: real Stripe) ---
SENTINELIQ_BILLING_PROVIDER=mock_stripe
SENTINELIQ_STRIPE_API_KEY=sk_test_placeholder
SENTINELIQ_DEFAULT_PLAN_SLUG=free

# --- CORS ---
SENTINELIQ_CORS_ORIGINS=["http://localhost:5173"]

# --- Frontend (frontend/.env or build-time env) ---
VITE_API_BASE_URL=http://localhost:8000/v1
